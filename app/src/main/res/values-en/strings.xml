    <string name="about_telemetry_title">Reports and statistics</string>
    <string name="about_telemetry">The app sends anonymous crash reports and minimal statistics: app and Android version, device model, ISP network number (ASN) and which strategies worked. IP address, device identifiers, visited sites and the app list are not collected or stored. See the privacy policy for details.</string>
    <string name="about_credits">Components</string>
    <string name="about_disclaimer">The bypass engine is based on byedpi (MIT). The Glasswave typeface was made by GREENTUNE for GT Unblock.</string>

    <string name="about_license">License</string>
    <string name="about_telemetry_title">Reports and statistics</string>
    <string name="about_telemetry">Glyde sends technical telemetry: a random ID, IP (up to 30 days), country/city, ISP/ASN, device parameters, network type, app version, connection state and supported-service test results. Crash reports help find defects. Browsing history, DNS queries and traffic contents are not collected; installed-app lists are not sent. See the privacy policy for details.</string>
    <string name="about_credits">Components</string>
    <string name="about_disclaimer">The bypass engine is based on byedpi (MIT). The Glyde Sans typeface was made by GREENTUNE for Glyde.</string>
